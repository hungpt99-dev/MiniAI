{
  "name": "miniai",
  "version": "0.1.0",
  "description": "MiniAI — popup AI assistant (BYOK)",
  "author": "MiniAI",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && npm run build:renderer && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/copy-renderer.js",
    "test": "vitest run",
    "dist": "npm run build:main && npm run build:renderer && electron-builder --win portable",
    "typecheck": "tsc -p tsconfig.main.json --noEmit"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.7.0",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.21.5": true
  }
}
