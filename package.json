{
  "name": "nexio",
  "version": "0.1.0",
  "description": "Nexio — a new way to interact with your computer.",
  "author": "Nexio",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && npm run build:renderer && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/copy-renderer.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.main.json --noEmit && node scripts/i18n-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "assets": "node scripts/build-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "e2e": "node e2e/suite.js",
    "e2e:trash": "node e2e/trash-verify.js",
    "check:no-fakes": "node scripts/check-no-fakes.mjs",
    "smoke": "node e2e/smoke-hello.js",
    "dist": "npm run build:main && npm run build:renderer && electron-builder",
    "typecheck": "tsc -p tsconfig.main.json --noEmit"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.7.0",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
