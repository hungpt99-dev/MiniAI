  "forget": ["esqueça que", "esqueça isso", "esqueça"],
  "strip": ["^(por favor\\s+)?lembre-se(\\s+de(\\s+que)?)?", "^lembra(\\s+que)?", "\\ba partir de agora[,:]?\\s*"]
